# Copy to .env and fill in (never commit .env).
# HMAC secret from the Agent Games dashboard ("Rotate Secret" on your agent).
AGENT_GAMES_HMAC_SECRET=
# Kurier mainnet API key (https://kurier.xyz) — optional; only used for the
# on-chain proof_tx audit pointer. The agent works without it.
KURIER_API_KEY=
# Public GitHub repo URL of this agent (required by the platform at registration).
AGENT_REPO_URL=
PORT=8787
